{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stageproof.github.io/stageproof/report.schema.json",
  "title": "Stageproof report",
  "description": "A stageproof check report, or the combined report written for a pull request. schema_version 1. Fields are added and not renamed.",
  "oneOf": [
    { "$ref": "#/$defs/report" },
    { "$ref": "#/$defs/combined" }
  ],
  "$defs": {
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "verdict",
        "exit_code",
        "adapter",
        "target_k8s",
        "base_ref",
        "head_ref",
        "checked",
        "duration_ms",
        "timestamp",
        "checks"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "verdict": { "enum": ["PROVEN", "PASSED", "BLOCKED", "NOT CHECKED"] },
        "exit_code": { "enum": [0, 1, 2] },
        "adapter": { "type": "string" },
        "target_k8s": { "type": "string" },
        "next_k8s_eol": { "type": "string" },
        "base_ref": { "type": "string" },
        "head_ref": { "type": "string" },
        "values_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "checked": { "type": "string" },
        "head_git": { "type": "string" },
        "cluster": { "type": "string" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "timestamp": { "type": "string", "format": "date-time" },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "skipped": {
          "type": "array",
          "items": { "$ref": "#/$defs/skip" }
        },
        "excluded_checks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "combined": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "verdict", "exit_code", "reports"],
      "properties": {
        "schema_version": { "const": 1 },
        "verdict": { "enum": ["PROVEN", "PASSED", "BLOCKED", "NOT CHECKED"] },
        "exit_code": { "enum": [0, 1, 2] },
        "head_git": { "type": "string" },
        "reports": {
          "type": "array",
          "items": { "$ref": "#/$defs/report" }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "summary"],
      "properties": {
        "name": { "type": "string" },
        "status": { "enum": ["pass", "fail", "warn", "skip"] },
        "summary": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "severity", "message"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["blocker", "warning", "info"] },
        "resource": { "type": "string" },
        "file": { "type": "string" },
        "message": { "type": "string" },
        "detail": { "type": "string" },
        "proof": { "type": "string" },
        "verified": { "type": "boolean" }
      }
    },
    "skip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason", "remediation"],
      "properties": {
        "code": { "type": "string" },
        "reason": { "type": "string" },
        "remediation": { "type": "string" }
      }
    }
  }
}
